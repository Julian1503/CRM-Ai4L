# AI4L content engine — example configuration. No real values here; copy to .env locally.
# Mock modes are ON by default: the engine runs end to end without any provider key.

APP_ENV=local
LOG_LEVEL=INFO

# ── CRM bridge (worker protocol v1) ──
CRM_BASE_URL=http://localhost:3000
# Engine → CRM (worker protocol). Same value as the CRM's CONTENT_WORKER_SECRET; ≥ 32 characters.
CONTENT_WORKER_SECRET=
# CRM → engine (OAuth API). Same value as the CRM's CONTENT_ENGINE_SECRET; ≥ 32 characters,
# different from CONTENT_WORKER_SECRET. Required by the api role.
CONTENT_ENGINE_SECRET=
WORKER_ID=
WORKER_KINDS=generate_text,generate_image,ingest_asset,publish_social
WORKER_CONCURRENCY=4
LEASE_SECONDS=120
WORKER_IDLE_POLL_SECONDS=2
WORKER_MAX_BACKOFF_SECONDS=30
WORKER_SHUTDOWN_GRACE_SECONDS=60
# Local Supabase serves signed Storage URLs over http://127.0.0.1. Never true in production.
STORAGE_ALLOW_HTTP=false

# ── LLM ──
LLM_MOCK=true
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_REASONING_EFFORT=low
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_TIMEOUT_SECONDS=60
LLM_MAX_ATTEMPTS=2
LLM_MAX_CONCURRENCY=6
GENERATION_DEADLINE_SECONDS=240

# ── Images (live generation requires LLM_PROVIDER=openai) ──
IMAGE_MODEL=gpt-image-1
IMAGE_SIZE=1024x1024
IMAGE_TIMEOUT_SECONDS=180
MEDIA_MAX_SOURCE_BYTES=15728640

# ── Reference URL fetch (SSRF-guarded) ──
REFERENCE_FETCH_TIMEOUT_SECONDS=8
REFERENCE_FETCH_MAX_BYTES=1000000
REFERENCE_FETCH_MAX_CHARS=4000
REFERENCE_FETCH_MAX_REDIRECTS=3

# ── Social publishing ──
PUBLISH_MOCK=true
PUBLISH_TIMEOUT_SECONDS=30
PUBLISH_MAX_ATTEMPTS=3
PUBLISH_RETRY_BASE_DELAY_SECONDS=0.5

# Meta (Facebook + Instagram). Revalidate the Graph version before going live.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0
META_LOGIN_CONFIG_ID=

# LinkedIn. Revalidate the API version before going live.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202506
