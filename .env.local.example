# Supabase Configuration
# Replace with your actual Supabase project URL and anon public key found in settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service-role key. Settings -> API -> service_role.
# SERVER ONLY. Bypasses Row Level Security completely.
# Never prefix with NEXT_PUBLIC_ and never import into a client component — see
# src/lib/supabase/admin.ts and the guard in src/lib/supabase/secrets.test.ts.
# Required by webhook handlers, which have no user session to authorise against.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# EmailOctopus Configuration
# Retrieve your API Key from https://emailoctopus.com/templates/api-keys
#
# NOTE: the APPLICATION does not read these two. It reads them from the `credentials`
# table, entered through the app's own settings screen -- see the send route and
# /api/integrations/emailoctopus/fields. Setting them in a deployment's environment is
# harmless but has no effect, and the app will still report "not connected".
#
# They are here because the OPS SCRIPTS do read them: `npm run db:sync-job-types`.
# See docs/DEPLOYMENT.md for the full manifest of what to set where.
EMAILOCTOPUS_API_KEY=your-emailoctopus-api-key-here
EMAILOCTOPUS_LIST_ID=your-emailoctopus-list-id-here

# Shared secret used to verify inbound EmailOctopus webhook signatures (Phase 3.2).
EMAILOCTOPUS_WEBHOOK_SECRET=your-emailoctopus-webhook-secret-here

# Location Autocomplete Configuration
# Geoapify offers a free API key for Address Autocomplete.
GEOAPIFY_API_KEY=your-geoapify-api-key-here

# --- Default admin seed (used only by `npm run db:create-admin`) ---
# One-off bootstrap credentials for the first dashboard login. Change the password
# from the app once you are in; nothing at runtime reads these.
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=generate-a-strong-one

# --- Stripe (Phase 5: booking) ---
# The consultation lists at $500 and is discounted to $0 by a 100%-off coupon.
# Create in Stripe: a $500 AUD one-off Price, and a Coupon at 100% off (duration: once).
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_CONSULTATION_PRICE_ID=price_your-500-aud-price-id
STRIPE_CONSULTATION_COUPON_ID=your-100-percent-off-coupon-id
# From the Stripe webhook endpoint you register for checkout.session.completed.
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# --- Calendly (Phase 5: scheduling) ---
# NOTE: Calendly webhooks require a paid plan (Standard or above). Without one no
# invitee.created event arrives and bookings stay stuck at "paid".
CALENDLY_WEBHOOK_SECRET=your-calendly-signing-key
# The public scheduling link for the 30-minute consultation event type.
NEXT_PUBLIC_CALENDLY_SCHEDULING_URL=https://calendly.com/your-account/30min

# --- Application ---
# Absolute origin used to build booking links in campaign emails. Must be the deployed
# host; falls back to the request origin locally, which would produce unreachable links
# in a real send.
#
# This is a BUILD-TIME value. The NEXT_PUBLIC_ prefix means Next inlines it into the
# build, so changing it in a hosting dashboard does nothing until you redeploy -- and it
# must be right before the first campaign send, because booking links go out inside
# emails and cannot be recalled. See docs/DEPLOYMENT.md section 3.
NEXT_PUBLIC_APP_URL=https://crm.your-domain.com

# --- Anthropic (Phase 4.6: AI campaign copy) ---
# Server-only. Used by /api/campaigns/generate to write the merge-field values a
# campaign template merges. Never prefix with NEXT_PUBLIC_.
#
# Nothing generated here can send on its own: copy lands on a draft campaign and a
# human still has to approve it, which the database enforces with a trigger.
#
# Without this key the Campaigns screen still works -- "Write with AI" returns a clear
# "not configured" error and copy can be typed by hand.
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
