# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
__pycache__/
# Playwright MCP session artefacts: page snapshots and console logs from ad-hoc
# browser driving, not part of the suite.
/.playwright-mcp/

# scratch
# Local throwaways -- one-off scripts, captured logs. Named so they are obviously
# disposable and cannot be mistaken for something the app needs.
.tmp-*

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the templates must be committed: README tells you to copy .env.local.example,
# and `.env*` above was silently excluding it.
!.env*.example

# vercel
.vercel

# supabase cli local state (project ref, temp files) -- machine-specific
/supabase/.temp/

# typescript
*.tsbuildinfo
next-env.d.ts
