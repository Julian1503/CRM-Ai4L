{
  "name": "crm-ai4l",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "verify:deployment": "node --env-file-if-exists=.env.local scripts/verify-deployment.mjs",
    "vercel:env": "node --env-file-if-exists=.env.local scripts/vercel-env-push.mjs",
    "typecheck": "tsc --noEmit",
    "db:types": "npx supabase gen types typescript --linked --schema public > src/lib/db/types.ts",
    "db:verify": "npm run db:verify:contacts && npm run db:verify:webhooks && npm run db:verify:campaigns && npm run db:verify:bookings",
    "db:verify:contacts": "npx supabase db query --linked --file supabase/tests/verify_20260807000000.sql",
    "db:verify:webhooks": "npx supabase db query --linked --file supabase/tests/verify_20260807010000.sql",
    "db:verify:campaigns": "npx supabase db query --linked --file supabase/tests/verify_20260808000000.sql",
    "db:verify:bookings": "npx supabase db query --linked --file supabase/tests/verify_20260808010000.sql",
    "db:create-admin": "node --env-file=.env.local supabase/create-admin.js",
    "db:sync-job-types": "node --env-file=.env.local supabase/sync-job-types.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@gsap/react": "^2.1.2",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.107.0",
    "gsap": "^3.15.0",
    "next": "16.2.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "stripe": "^22.4.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "typescript": "^5"
  }
}
